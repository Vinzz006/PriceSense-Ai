# AI PriceSense Backend Configuration
PROJECT_NAME="AI PriceSense"
TAGLINE="Smarter Agricultural Pricing Through AI"
VERSION="1.0.0"
API_PREFIX="/api"

# Pretrained Hugging Face Model Identifier
MODEL_ID="amazon/chronos-bolt-small"

# Device configuration: 'auto', 'cpu', or 'cuda'
DEVICE="auto"

# Default Forecast Horizon (1, 3, 7, 14)
DEFAULT_HORIZON=7

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
