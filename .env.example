# AI PriceSense Environment Variables

# Pretrained AI Model
MODEL_ID=amazon/chronos-bolt-small
DEVICE=auto

# Google Gemini API (Conversational Intelligence)
# Leave blank to use grounded local rule-based agricultural assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs API (Text-to-Speech)
# Leave blank for text-only mode (or client-side preview indicator)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

